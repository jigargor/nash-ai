    },
    "properties": {
      "findings": {
        "items": {
          "$ref": "#/$defs/Finding"
        },
        "title": "Findings",
        "type": "array"
      },
      "summary": {
        "maxLength": 800,
        "title": "Summary",
        "type": "string"
      }
    },
    "required": [
      "findings",
      "summary"
    ],
    "title": "ReviewResult",
    "type": "object"
  },
  "review_statuses": [
    "queued",
    "running",
    "done",
    "failed",
    "skipped",
    "canceled",
    "partial",
    "rate_limited",
    "budget_exhausted"
  ],
  "terminal_statuses": [
    "success",
    "skipped",
    "failed",
    "canceled",
    "partial",
    "rate_limited",
    "budget_exhausted"
  ]
